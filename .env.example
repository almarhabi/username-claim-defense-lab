# Synthetic lab administration only; never reuse a real password or API key.
LAB_ADMIN_KEY=replace-with-a-long-random-lab-key
LAB_COOLDOWN_SECONDS=1209600
LAB_RATE_LIMIT=20
LAB_SESSION_TTL_SECONDS=3600

# This password belongs exclusively to the generated synthetic fixtures.
# The bot reads it locally; users never send it in Telegram messages.
LAB_FIXTURE_PASSWORD=lab-only-password

# Optional Telegram controller. These control only the synthetic local service.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
